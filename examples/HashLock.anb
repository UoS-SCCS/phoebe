# Hash-Lock protocol (randomized, reader-nonce RFID authentication).
# One of the RFID case studies proved UNLINKABLE by Hirschi, Baelde, Delaune.
#
#   R -> T : nR
#   T -> R : nT, h(nR, nT, k)
#
# k is the tag's secret, shared with the reader's database.
# `phi` : the reader identifies the tag by finding the key that reproduces the
#         hash (a post-condition lookup, as in Basic-Hash).

protocol HashLock
roles   R T
nonces  NR NT
keys    KT

R -> T : NR                                  ; new NR
T -> R : < NT, hash(< NR, NT, KT >) >        ; new NT ; recv_post phi
